{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "horo",
  "identifier": "lt.uwu.uwum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "horo",
        "label": "main",
        "width": 1280,
        "height": 832,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0B0B0F",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' horo: http://horo.localhost data: blob:; media-src 'self' horo: http://horo.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost https: wss: blob:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "a cute matrix client",
    "longDescription": "horo — a Matrix client with end-to-end encryption and LiveKit voice, in the UwU design system.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-nice",
          "gstreamer1.0-pipewire",
          "xdg-desktop-portal"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "libnice-gstreamer1",
          "pipewire-gstreamer",
          "xdg-desktop-portal"
        ]
      }
    },
    "iOS": {
      "developmentTeam": "Q54KD9V8NQ",
      "minimumSystemVersion": "15.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNkE2NTFBNDk4NDZDMEIKUldRTGJJUkpHbVZxSUxScldxR0hSb1FZeUVGUVVtNHdLWnkrejNnWndYYlR3a2VLd3BabmxQS00K",
      "endpoints": [
        "https://github.com/gitautas/horo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
